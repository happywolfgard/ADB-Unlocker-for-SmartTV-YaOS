<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:orientation="horizontal"
    android:padding="24dp">

    <!-- Left Column: Status, Log & Hints -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:layout_marginEnd="20dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/title"
            android:textColor="@color/text_white"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/subtitle"
            android:textColor="@color/text_muted"
            android:textSize="15sp" />

        <!-- Status Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/card_bg"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvIp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="IP: проверяется..."
                android:textColor="@color/text_white"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Порт 5555: проверяется..."
                android:textColor="@color/status_red"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvRoot"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Root: проверяется..."
                android:textColor="@color/text_muted"
                android:textSize="15sp" />

        </LinearLayout>

        <!-- Instructions Box -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/card_bg"
            android:orientation="vertical"
            android:padding="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Комбинация пульта (в меню 'Изображение'):"
                android:textColor="#F59E0B"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="➡️ Вправо -> ⬆️ Вверх -> ➡️ Вправо -> ⬆️ Вверх -> ⬅️ Назад"
                android:textColor="@color/text_white"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Live Log -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="10dp"
            android:background="@drawable/card_bg"
            android:padding="10dp">

            <TextView
                android:id="@+id/tvLog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Журнал:\nГотов к запуску."
                android:textColor="#CBD5E1"
                android:textSize="13sp"
                android:typeface="monospace" />
        </ScrollView>

    </LinearLayout>

    <!-- Right Column: Focusable Action Buttons & Dynamic Menu List -->
    <ScrollView
        android:id="@+id/scrollViewActions"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1.3">

        <LinearLayout
            android:id="@+id/layoutButtons"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <Button
                android:id="@+id/btnActivate"
                android:layout_width="match_parent"
                android:layout_height="62dp"
                android:background="@drawable/btn_accent_selector"
                android:clickable="true"
                android:focusable="true"
                android:text="🚀 Цикл команд для включения ADB (5555)"
                android:textColor="@color/text_white"
                android:textSize="17sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnFactoryMenu"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/btn_selector"
                android:clickable="true"
                android:focusable="true"
                android:text="🛠 Открыть Factory / Заводское меню"
                android:textColor="@color/text_white"
                android:textSize="15sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnScanFactory"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/btn_selector"
                android:clickable="true"
                android:focusable="true"
                android:text="🔍 Найти ВСЕ скрытые сервисные меню на ТВ"
                android:textColor="@color/text_white"
                android:textSize="15sp" />

            <Button
                android:id="@+id/btnDevSettings"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/btn_selector"
                android:clickable="true"
                android:focusable="true"
                android:text="⚙️ Меню разработчика чистого Android"
                android:textColor="@color/text_white"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btnWirelessDebug"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/btn_selector"
                android:clickable="true"
                android:focusable="true"
                android:text="📶 Меню беспроводной отладки"
                android:textColor="@color/text_white"
                android:textSize="14sp" />

            <Button
                android:id="@+id/btnAllSettings"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/btn_selector"
                android:clickable="true"
                android:focusable="true"
                android:text="📱 Меню настроек изображения / экрана"
                android:textColor="@color/text_white"
                android:textSize="14sp" />

            <!-- Dynamic Container for discovered activities -->
            <TextView
                android:id="@+id/tvFoundHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="Найденные сервисные компоненты на ТВ:"
                android:textColor="#38BDF8"
                android:textSize="14sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/layoutFoundActivities"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="6dp" />

        </LinearLayout>
    </ScrollView>

</LinearLayout>
